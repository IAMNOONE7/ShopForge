{
  "name": "shopforge-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:repeat": "playwright test --repeat-each=20",
    "test:unit": "node --test --experimental-strip-types support/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "report": "playwright show-report artifacts/report",
    "install:browser": "playwright install chromium",
    "test:isolated": "playwright test --config playwright.isolated.config.ts",
    "test:isolated:repeat": "playwright test --config playwright.isolated.config.ts --repeat-each=20 --global-timeout=12000000 --max-failures=1",
    "test:merchant": "playwright test --config playwright.merchant.config.ts",
    "test:merchant:repeat": "playwright test --config playwright.merchant.config.ts --repeat-each=20 --global-timeout=12000000 --max-failures=1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.13.3",
    "oxlint": "1.81.0",
    "typescript": "6.0.2"
  }
}
