{
  "ConnectionStrings": {
    "ShopForge": "Host=localhost;Port=5433;Database=shopforge;Username=shopforge;Password=shopforge",
    "FileStorage": "UseDevelopmentStorage=true"
  },
  "Logging": {
    "LogLevel": {
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "ShopForge.Infrastructure.Email.LoggingEmailDelivery": "Debug"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": false,
        "TimestampFormat": "HH:mm:ss ",
        "UseUtcTimestamp": false
      }
    }
  }
}
